{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toddlers-learn.local/packs/schema/manifest.json",
  "title": "Pack Manifest",
  "description": "Versioned content pack manifest declaring pack metadata, supported schema versions, locales, retired slug blocklist, and SHA-256 integrity digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "version",
    "schema_version",
    "supported_schema_versions",
    "locale",
    "default_locale",
    "locales_available",
    "age_band",
    "status",
    "tags",
    "created_by",
    "reviewed_by",
    "notes_author",
    "demo",
    "parent_gate_required",
    "retired_ids",
    "dependencies",
    "title_ref",
    "summary_ref",
    "file_hashes",
    "pack_sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique pack slug id (never reused)."
    },
    "record_type": {
      "type": "string",
      "const": "manifest"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "Pack semantic version (semver)."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "Schema version this pack was authored against (semver)."
    },
    "supported_schema_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
      },
      "description": "List of schema versions supported by this pack."
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$",
      "description": "BCP 47 locale tag."
    },
    "default_locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$",
      "description": "Default BCP 47 locale for this pack."
    },
    "locales_available": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$"
      },
      "description": "All complete locales shipped in strings.json."
    },
    "age_band": {
      "type": "string",
      "enum": ["2-3", "3-4", "4-5", "2-5"],
      "description": "Target preschool age band."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "live"],
      "description": "Lifecycle status of the record."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "notes_author": {
      "type": "string",
      "description": "Internal authoring notes (never shown to the child)."
    },
    "demo": {
      "type": "boolean",
      "description": "True if this pack is a demo pack used only to prove the pipeline."
    },
    "parent_gate_required": {
      "type": "boolean",
      "const": true,
      "description": "Gating flag present and consistent for adult-facing pack controls."
    },
    "gating": {
      "type": "string",
      "enum": ["free", "paid"],
      "default": "free",
      "description": "Pack monetization gate. Absent or \"free\" means the core free pack; \"paid\" marks a purchasable pack. Read later by the store/product layer."
    },
    "retired_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Blocklisted slug IDs that have been deleted/retired and may never be reused."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Declared pack dependencies."
    },
    "title_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$",
      "description": "Dot-namespaced string_ref in strings.json."
    },
    "summary_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$",
      "description": "Dot-namespaced string_ref in strings.json."
    },
    "file_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "description": "SHA-256 hex digest per pack file."
    },
    "pack_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Aggregate SHA-256 hex digest across all file_hashes entries."
    }
  }
}
