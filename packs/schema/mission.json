{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toddlers-learn.local/packs/schema/mission.json",
  "title": "Mission Record",
  "description": "Device-down cooperative mission with universal household items and mandatory 3-level alternative chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "version",
    "locale",
    "age_band",
    "status",
    "tags",
    "created_by",
    "reviewed_by",
    "notes_author",
    "title_ref",
    "skill_id",
    "parent_script_ref",
    "child_prompt_ref",
    "team_goal_ref",
    "parent_precheck",
    "parent_gate_required",
    "estimated_minutes",
    "cooperative_only",
    "song_id",
    "song_fallback_rule",
    "return_ritual_ref",
    "safety_notes_refs",
    "objects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "record_type": {
      "type": "string",
      "const": "mission"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$"
    },
    "age_band": {
      "type": "string",
      "enum": ["2-3", "3-4", "4-5", "2-5"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "live"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "notes_author": {
      "type": "string"
    },
    "title_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parent_script_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "child_prompt_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$",
      "description": "String reference whose resolved text is at most 20 words."
    },
    "team_goal_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$",
      "description": "Required cooperative team-goal string reference."
    },
    "parent_precheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "prompt_ref", "space_clear_check", "adult_present_check"],
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        },
        "prompt_ref": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        },
        "space_clear_check": {
          "type": "boolean",
          "const": true
        },
        "adult_present_check": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "parent_gate_required": {
      "type": "boolean",
      "const": true
    },
    "estimated_minutes": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "cooperative_only": {
      "type": "boolean",
      "const": true
    },
    "song_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "song_fallback_rule": {
      "type": "string",
      "enum": ["use_lesson_song_template", "hum_gentle_cadence"]
    },
    "return_ritual_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$",
      "description": "Return ritual string_ref with no proof/judgement language."
    },
    "safety_notes_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "picture_ref",
          "label_ref",
          "alternative_object_id",
          "alternative_picture_ref",
          "fallback_body_action_id",
          "fallback_body_picture_ref"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "picture_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
          },
          "alternative_object_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "alternative_picture_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fallback_body_action_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Level 3 zero-object body/pretend alternative so every household can participate."
          },
          "fallback_body_picture_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
