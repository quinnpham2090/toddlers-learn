{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toddlers-learn.local/packs/schema/skill.json",
  "title": "Skill Record",
  "description": "Learning skill node in an acyclic prerequisite graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "version",
    "locale",
    "age_band",
    "status",
    "tags",
    "created_by",
    "reviewed_by",
    "notes_author",
    "title_ref",
    "description_ref",
    "domain",
    "is_entry_skill",
    "prerequisites",
    "next_skills",
    "age_band_min",
    "evidence_needed_to_advance",
    "catch_up_variant_of"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique slug id (never reused)."
    },
    "record_type": {
      "type": "string",
      "const": "skill"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$"
    },
    "age_band": {
      "type": "string",
      "enum": ["2-3", "3-4", "4-5", "2-5"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "live"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "notes_author": {
      "type": "string"
    },
    "title_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "description_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "language",
        "numeracy",
        "music",
        "motor_routine",
        "social_cooperative",
        "time_concepts",
        "world_discovery"
      ],
      "description": "Learning domain of the skill."
    },
    "is_entry_skill": {
      "type": "boolean",
      "description": "True if this skill is an entry point in the skill graph."
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Prerequisite skill IDs (must form a DAG; every non-entry skill reachable from an entry skill)."
    },
    "next_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "description": "Downstream skill IDs."
    },
    "age_band_min": {
      "type": "string",
      "enum": ["2-3", "3-4", "4-5"],
      "description": "Minimum age band for introducing this skill."
    },
    "evidence_needed_to_advance": {
      "type": "integer",
      "minimum": 3,
      "description": "Floor of 3 qualifying events required to advance."
    },
    "catch_up_variant_of": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Optional skill ID this is a catch-up variant of (chains are prohibited)."
    }
  }
}
