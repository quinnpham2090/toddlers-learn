{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toddlers-learn.local/packs/schema/character.json",
  "title": "Character Record",
  "description": "Original guide character record with originality attestation and string_ref dialogue only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "version",
    "locale",
    "age_band",
    "status",
    "tags",
    "created_by",
    "reviewed_by",
    "notes_author",
    "name_ref",
    "species_or_role",
    "originality_attestation",
    "appearance",
    "voice_profile",
    "personality_lines",
    "world_home_id",
    "model_asset_path",
    "fallback_character_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "record_type": {
      "type": "string",
      "const": "character"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$"
    },
    "age_band": {
      "type": "string",
      "enum": ["2-3", "3-4", "4-5", "2-5"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "live"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "notes_author": {
      "type": "string"
    },
    "name_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$",
      "description": "Dot-namespaced string_ref in strings.json for the character placeholder title."
    },
    "species_or_role": {
      "type": "string",
      "enum": ["lantern_guide", "words_companion", "rhythm_companion", "routine_helper"]
    },
    "originality_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attester", "date", "derivation_statement"],
      "properties": {
        "attester": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "derivation_statement": {
          "type": "string",
          "minLength": 20,
          "description": "Statement of original derivation of at least 20 characters."
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouette_shape", "primary_palette", "distinctive_prop"],
      "properties": {
        "silhouette_shape": {
          "type": "string",
          "enum": ["rounded_lantern", "leaf_cape", "bell_pebble", "cloud_cushion"]
        },
        "primary_palette": {
          "type": "string",
          "enum": ["warm_ochre_teal", "sage_coral", "indigo_amber", "meadow_gold"]
        },
        "distinctive_prop": {
          "type": "string",
          "enum": ["wooden_chime", "story_leaf", "felt_drum", "sun_dial_ring"]
        }
      }
    },
    "voice_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "pacing_wpm", "synth_fallback_enabled"],
      "properties": {
        "register": {
          "type": "string",
          "enum": ["warm_alto", "gentle_baritone", "soft_mezzo"]
        },
        "pacing_wpm": {
          "type": "integer",
          "minimum": 90,
          "maximum": 130
        },
        "synth_fallback_enabled": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "personality_lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
      },
      "description": "Array of dot-namespaced string_refs in strings.json (never inline free text)."
    },
    "world_home_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "model_asset_path": {
      "type": "string",
      "pattern": "^assets/[a-z0-9/_-]+\\.(svg|png|webp)$"
    },
    "fallback_character_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
