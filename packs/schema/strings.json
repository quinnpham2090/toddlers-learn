{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toddlers-learn.local/packs/schema/strings.json",
  "title": "Pack Strings Table",
  "description": "Locale-keyed dictionary of dot-namespaced user-facing strings. Every locale in locales_available must have the complete set of string_refs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "version", "locales"],
  "properties": {
    "record_type": {
      "type": "string",
      "const": "strings"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
