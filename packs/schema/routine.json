{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toddlers-learn.local/packs/schema/routine.json",
  "title": "Routine Record",
  "description": "Daily cooperative routine anchored to a closed anchor enum and time_of_day (at most 1 per time_of_day per pack).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "version",
    "locale",
    "age_band",
    "status",
    "tags",
    "created_by",
    "reviewed_by",
    "notes_author",
    "title_ref",
    "anchor",
    "time_of_day",
    "skill_id",
    "parent_script_ref",
    "child_prompt_ref",
    "team_goal_ref",
    "cooperative_only",
    "song_id",
    "song_fallback_rule",
    "return_ritual_ref",
    "safety_notes_refs",
    "objects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "record_type": {
      "type": "string",
      "const": "routine"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2}|-[a-zA-Z0-9]{2,8})*$"
    },
    "age_band": {
      "type": "string",
      "enum": ["2-3", "3-4", "4-5", "2-5"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "live"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+)*$"
      }
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "notes_author": {
      "type": "string"
    },
    "title_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "anchor": {
      "type": "string",
      "enum": [
        "morning_wake",
        "mealtime_prep",
        "tidy_together",
        "bath_splash",
        "bedtime_winddown"
      ],
      "description": "Closed anchor enum for routines."
    },
    "time_of_day": {
      "type": "string",
      "enum": ["morning", "midday", "afternoon", "evening"],
      "description": "Time of day slot (at most 1 routine per time_of_day per pack)."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parent_script_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "child_prompt_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "team_goal_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "cooperative_only": {
      "type": "boolean",
      "const": true
    },
    "song_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "song_fallback_rule": {
      "type": "string",
      "enum": ["use_lesson_song_template", "hum_gentle_cadence"]
    },
    "return_ritual_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
    },
    "safety_notes_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "picture_ref",
          "label_ref",
          "alternative_object_id",
          "alternative_picture_ref",
          "fallback_body_action_id",
          "fallback_body_picture_ref"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "picture_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label_ref": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
          },
          "alternative_object_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "alternative_picture_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fallback_body_action_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "fallback_body_picture_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
